# Copy this file to .env and fill in the values from
# Supabase dashboard -> Project Settings -> API.
# Only the anon (public) key belongs here. NEVER put the service_role key in
# any VITE_ variable: everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Support contact shown on the Help page (e.g. a project or adviser email).
VITE_CONTACT_EMAIL=

# SeaScan Flask API (app.py), e.g. https://seascan-api.onrender.com or
# http://localhost:5000. Leave empty to read everything straight from Supabase
# (identification results are then not logged).
VITE_API_URL=
